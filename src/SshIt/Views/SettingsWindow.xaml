<Window x:Class="SshIt.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options" Width="640" Height="620" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="22,18,22,10">
            <TextBlock Text="Options" FontSize="20" FontWeight="SemiBold" />
        </StackPanel>

        <TabControl Grid.Row="1" Margin="22,0,22,0">
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="2,16,2,16">
                        <TextBlock Text="Application theme" Style="{StaticResource Text.Header}" Margin="0,0,0,6" />
                        <ComboBox x:Name="ThemeBox" Margin="0,0,0,16" />

                        <TextBlock Text="Terminal colour scheme" Style="{StaticResource Text.Header}" Margin="0,0,0,6" />
                        <ComboBox x:Name="TerminalThemeBox" Margin="0,0,0,16" />

                        <TextBlock Text="Terminal font" Style="{StaticResource Text.Header}" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FontBox" />
                            <TextBox x:Name="FontSizeBox" Grid.Column="1" Width="64" Margin="8,0,0,0" />
                        </Grid>

                        <TextBlock Text="Cursor" Style="{StaticResource Text.Header}" Margin="0,0,0,6" />
                        <ComboBox x:Name="CursorBox" Margin="0,0,0,12">
                            <ComboBoxItem Content="Block" Tag="0" />
                            <ComboBoxItem Content="Bar" Tag="1" />
                            <ComboBoxItem Content="Underline" Tag="2" />
                        </ComboBox>
                        <CheckBox x:Name="BlinkCheck" Content="Blink the cursor" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Behaviour">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="2,16,2,16">
                        <CheckBox x:Name="ConfirmCloseCheck" Content="Ask before closing a connected session or the window" Margin="0,4" />
                        <CheckBox x:Name="CloseToTrayCheck" Content="Closing the window keeps SSH-it in the notification area" Margin="0,4" />
                        <CheckBox x:Name="MinimizeToTrayCheck" Content="Minimising hides the window to the notification area" Margin="0,4" />
                        <CheckBox x:Name="ReopenCheck" Content="Reopen the previous tabs on start-up" Margin="0,4" />
                        <CheckBox x:Name="MultiPasteCheck" Content="Warn before pasting more than three lines" Margin="0,4" />
                        <CheckBox x:Name="BellCheck" Content="Play a sound when the remote terminal rings the bell" Margin="0,4" />
                        <CheckBox x:Name="LogCheck" Content="Write a transcript of each session to the log folder" Margin="0,4" />
                        <CheckBox x:Name="RecordCheck" Content="Record sessions as asciinema .cast files" Margin="0,4" />
                        <CheckBox x:Name="AgentGateCheck" Content="Agent verbs may only use sessions marked 'Allow agent commands'" Margin="0,4" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Terminal">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="2,16,2,16">
                        <TextBlock Text="Scrollback lines" Style="{StaticResource Text.Header}" Margin="0,0,0,6" />
                        <TextBox x:Name="ScrollbackBox" Width="120" HorizontalAlignment="Left" Margin="0,0,0,16" />
                        <CheckBox x:Name="CopyOnSelectCheck" Content="Copy to the clipboard as soon as text is selected" Margin="0,4" />
                        <TextBlock Text="Scrollback is kept in memory for the life of the tab. Larger values cost roughly 16 bytes per cell."
                                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                                   Margin="0,14,0,0" />

                        <TextBlock Text="Keyword highlighting" Style="{StaticResource Text.Header}" Margin="0,22,0,6" />
                        <Button Content="Highlighting…" Width="140" HorizontalAlignment="Left" Click="OpenHighlighting_Click" />
                        <TextBlock x:Name="HighlightSummary" Text="" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Data">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="2,16,2,16">
                        <TextBlock Text="Data folder" Style="{StaticResource Text.Header}" Margin="0,0,0,6" />
                        <TextBox x:Name="DataPathBox" IsReadOnly="True" Margin="0,0,0,8" />
                        <Button Content="Open folder" Width="120" HorizontalAlignment="Left" Click="OpenData_Click" />
                        <TextBlock x:Name="PortableText" Text="" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" Margin="0,16,0,0" />
                        <TextBlock Text="Sessions are plain JSON. Passwords, when you choose to save one, go to Windows Credential Manager — never to disk."
                                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Background="{DynamicResource Brush.PanelAlt}" Padding="18,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="92" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Save" Width="104" Style="{StaticResource Btn.Accent}" IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
