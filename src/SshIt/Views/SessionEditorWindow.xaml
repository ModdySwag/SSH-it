<Window x:Class="SshIt.Views.SessionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session" Width="620" Height="700" MinHeight="560" MinWidth="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="22,18,22,12">
            <StackPanel>
                <TextBlock x:Name="HeadingText" Text="New session" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Connection details are passed to the OpenSSH client."
                           Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,16,0">
            <StackPanel>
                <TextBlock Text="GENERAL" Style="{StaticResource Text.Header}" Margin="0,6,0,8" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Name" VerticalAlignment="Center" />
                    <TextBox x:Name="NameBox" Grid.Column="1" AutomationProperties.Name="Session name" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Host" VerticalAlignment="Center" />
                    <TextBox x:Name="HostBox" Grid.Column="1" AutomationProperties.Name="Host" />
                    <TextBox x:Name="PortBox" Grid.Column="2" Width="76" Margin="8,0,0,0" ToolTip="Port" AutomationProperties.Name="Port" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="User name" VerticalAlignment="Center" />
                    <TextBox x:Name="UserBox" Grid.Column="1" AutomationProperties.Name="User name" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Folder" VerticalAlignment="Center" />
                    <ComboBox x:Name="FolderBox" Grid.Column="1" AutomationProperties.Name="Folder" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Colour tag" VerticalAlignment="Center"
                               ToolTip="A colour for this session in the tree and on its tab" />
                    <WrapPanel x:Name="TagPanel" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Colour tag" />
                </Grid>

                <CheckBox x:Name="AliasCheck" Content="Connect through an OpenSSH config Host alias"
                          Margin="150,2,0,8" Checked="AliasCheck_Changed" Unchecked="AliasCheck_Changed" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Config alias" VerticalAlignment="Center" />
                    <TextBox x:Name="AliasBox" Grid.Column="1" IsEnabled="False" AutomationProperties.Name="Config alias" />
                </Grid>

                <TextBlock Text="AUTHENTICATION" Style="{StaticResource Text.Header}" Margin="0,14,0,8" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Method" VerticalAlignment="Center" />
                    <ComboBox x:Name="AuthBox" Grid.Column="1" AutomationProperties.Name="Authentication method" SelectionChanged="AuthBox_SelectionChanged">
                        <ComboBoxItem Content="SSH agent (recommended)" Tag="Agent" />
                        <ComboBoxItem Content="Private key file" Tag="Key" />
                        <ComboBoxItem Content="Password" Tag="Password" />
                    </ComboBox>
                </Grid>

                <Grid x:Name="KeyRow" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Key file" VerticalAlignment="Center" />
                    <TextBox x:Name="KeyBox" Grid.Column="1" AutomationProperties.Name="Key file" />
                    <Button Content="Browse…" Grid.Column="2" Margin="8,0,0,0" Click="BrowseKey_Click" />
                </Grid>

                <Grid x:Name="PasswordRow" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Password" VerticalAlignment="Center" />
                    <PasswordBox x:Name="PasswordBox" Grid.Column="1" AutomationProperties.Name="Password" />
                </Grid>

                <CheckBox x:Name="SaveSecretCheck" Content="Save the password in Windows Credential Manager"
                          Margin="150,0,0,10" />

                <TextBlock Text="ADVANCED" Style="{StaticResource Text.Header}" Margin="0,14,0,8" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Jump host" VerticalAlignment="Center" />
                    <TextBox x:Name="JumpBox" Grid.Column="1" ToolTip="user@bastion, or a chain: user@a:2222,user@b:2222 — add =C:\keys\path to a hop to give that hop its own key" AutomationProperties.Name="Jump host" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Startup command" VerticalAlignment="Center" />
                    <TextBox x:Name="StartupBox" Grid.Column="1" ToolTip="Sent once the shell is ready" AutomationProperties.Name="Startup command" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Notes" VerticalAlignment="Top" Margin="0,8,0,0" />
                    <TextBox x:Name="NotesBox" Grid.Column="1" Height="70" AcceptsReturn="True" AutomationProperties.Name="Notes"
                             TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="9,7" />
                </Grid>

                <StackPanel Margin="150,4,0,16">
                    <CheckBox x:Name="AgentForwardCheck" Content="Forward the SSH agent" Margin="0,4" />
                    <CheckBox x:Name="CompressionCheck" Content="Enable compression" Margin="0,4" />
                    <CheckBox x:Name="StrictCheck" Content="Verify host keys strictly" Margin="0,4" />
                    <CheckBox x:Name="AllowAgentCheck" Content="Allow agent commands to use this session" Margin="0,4" />
                    <CheckBox x:Name="X11Check" Content="Forward X11 (run remote GUI programs here)"
                              Margin="0,10,0,2" Checked="X11Check_Changed" Unchecked="X11Check_Changed" />
                    <TextBlock x:Name="X11Hint" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,0"
                               Foreground="{DynamicResource Brush.TextMuted}" />

                    <Separator Margin="0,12,0,8" />
                    <TextBlock Text="Connection type" Style="{StaticResource Text.Header}" Margin="0,0,0,4" />
                    <ComboBox x:Name="KindBox" Margin="0,0,0,8" AutomationProperties.Name="Connection type">
                        <ComboBoxItem Content="SSH" Tag="Ssh" />
                        <ComboBoxItem Content="Telnet" Tag="Telnet" />
                        <ComboBoxItem Content="Serial" Tag="Serial" />
                        <ComboBoxItem Content="Local shell" Tag="Local" />
                        <ComboBoxItem Content="tmux (control mode)" Tag="Tmux" />
                    </ComboBox>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Serial port" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                            <TextBox x:Name="SerialPortBox" AutomationProperties.Name="Serial port" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Baud" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                            <TextBox x:Name="SerialBaudBox" AutomationProperties.Name="Baud rate" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Telnet uses the host and port fields above; serial ignores them. Neither supports SFTP or tunnels."
                               FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="tmux session name" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBox x:Name="TmuxSessionBox" AutomationProperties.Name="tmux session name" />
                        <TextBlock Text="Blank attaches to the most recent tmux session. A tmux session opens in its own window, using this session's SSH settings."
                                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Background="{DynamicResource Brush.PanelAlt}" Padding="18,12">
            <Grid>
                <TextBlock x:Name="ValidationText" Foreground="{DynamicResource Brush.Danger}" FontSize="12"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Width="92" IsCancel="True" Margin="0,0,8,0" />
                    <Button x:Name="SaveButton" Content="Save" Width="104" Style="{StaticResource Btn.Accent}"
                            IsDefault="True" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
